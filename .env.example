# ============================================================
#  Transcriptor AI — Configurare
# ============================================================

# Cheia Anthropic API pentru rezumat AI (optionala)
# Obtine o cheie la: https://console.anthropic.com
# Fara aceasta cheie, transcrierea functioneaza in continuare,
# dar butonul "Rezumat AI" nu va fi disponibil.
ANTHROPIC_API_KEY=sk-ant-...

# Modelul Whisper pentru transcriere (default: medium)
# Optiuni: tiny, base, small, medium, large-v3
# - tiny/base: rapid, mai putin precis
# - small: echilibru bun
# - medium: recomandat (bun pentru romana)
# - large-v3: cel mai precis, mai lent
WHISPER_MODEL=medium

# Limba pentru transcriere (default: ro = romana)
# Alte optiuni: en (engleza), fr (franceza), de (germana), etc.
LANGUAGE=ro
