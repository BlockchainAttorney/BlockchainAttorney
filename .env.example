# ============================================================
#  Transcriptor AI — Configurare
# ============================================================

# --- TRANSCRIERE: Groq Whisper API (OBLIGATORIU) ---
# Gratuit pentru ~2 ore audio/zi, foarte rapid, suporta romana.
# Obtine cheia (instant, fara card): https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Modelul Groq Whisper (default: whisper-large-v3)
# Optiuni: whisper-large-v3, whisper-large-v3-turbo
GROQ_MODEL=whisper-large-v3

# --- REZUMAT AI: Claude API (RECOMANDAT) ---
# Pentru analiza convorbirii cu puncte cheie, actiuni, etc.
# Obtine cheia: https://console.anthropic.com
# Cost: ~$0.001 per convorbire (foarte ieftin)
ANTHROPIC_API_KEY=sk-ant-...

# --- GOOGLE DRIVE: Salvare cloud (OPTIONAL) ---
# Pentru a salva transcriptele automat ca Google Docs in Drive-ul tau.
# Setup pas-cu-pas in GOOGLE_SETUP.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_FOLDER_NAME=Transcripte Clienti

# --- SETARI GENERALE ---
# Limba pentru transcriere (default: ro)
LANGUAGE=ro

# Cheie secreta pentru sesiuni Flask (genereaza una unica in productie)
FLASK_SECRET_KEY=schimba-aceasta-cheie-in-productie-cu-ceva-unic

# URL aplicatiei (necesar in productie pentru Google OAuth redirect)
# In local lasa gol. Pe Render seteaza la URL-ul tau (ex: https://transcriptor.onrender.com)
APP_URL=

# Mediu (development sau production)
FLASK_ENV=development
